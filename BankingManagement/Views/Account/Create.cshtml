@model BankingManagement.DTOs.CreateAccountDTO

@{
    ViewBag.Title = "Create Account";
}

<div class="bank-page-header">

    <div>

        <p class="section-label">
            ACCOUNT MANAGEMENT
        </p>

        <h2>
            Create Account
        </h2>

        <p class="bank-page-subtitle">
            Create a new bank account for a registered customer.
        </p>

    </div>

    <div class="secure-badge">
        🔒 Administrator
    </div>

</div>


<div class="transfer-layout">

    <!-- =====================================================
         ACCOUNT FORM
         ===================================================== -->

    <div class="bank-form-card">

        <div class="bank-form-header">

            <div class="bank-form-icon">
                💳
            </div>

            <div>

                <h3>
                    Account Details
                </h3>

                <p>
                    Enter the account information below.
                </p>

            </div>

        </div>

        <hr />

        @using (Html.BeginForm(
            "Create",
            "Account",
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(
                true,
                "",
                new { @class = "text-danger" }
            )


            <!-- CUSTOMER -->

            <div class="bank-form-group">

                @Html.LabelFor(
                    model => model.CustomerId,
                    "Customer"
                )

                @Html.DropDownListFor(
                    model => model.CustomerId,
                    new SelectList(
                        ViewBag.Customers,
                        "CustomerId",
                        "FullName"
                    ),
                    "-- Select Customer --",
                    new
                    {
                        @class = "form-control"
                    }
                )

                <small class="form-help">
                    Select the customer who will own this account.
                </small>

                @Html.ValidationMessageFor(
                    model => model.CustomerId,
                    "",
                    new { @class = "text-danger" }
                )

            </div>


            <!-- ACCOUNT TYPE -->

            <div class="bank-form-group">

                @Html.LabelFor(
                    model => model.AccountType,
                    "Account Type"
                )

                @Html.DropDownListFor(
                    model => model.AccountType,
                    new SelectList(
                        new[]
                        {
                            "Savings",
                            "Current"
                        }
                    ),
                    "-- Select Account Type --",
                    new
                    {
                        @class = "form-control"
                    }
                )

                <small class="form-help">
                    Choose the type of bank account to create.
                </small>

                @Html.ValidationMessageFor(
                    model => model.AccountType,
                    "",
                    new { @class = "text-danger" }
                )

            </div>


            <!-- INITIAL BALANCE -->

            <div class="bank-form-group">

                @Html.LabelFor(
                    model => model.Balance,
                    "Initial Balance"
                )

                <div class="amount-input-wrapper">

                    <span class="currency-symbol">
                        ₹
                    </span>

                    @Html.TextBoxFor(
                        model => model.Balance,
                        new
                        {
                            @class = "form-control amount-input",
                            type = "number",
                            min = "0",
                            step = "0.01",
                            placeholder = "0.00"
                        }
                    )

                </div>

                <small class="form-help">
                    Enter the opening balance for the account.
                </small>

                @Html.ValidationMessageFor(
                    model => model.Balance,
                    "",
                    new { @class = "text-danger" }
                )

            </div>


            <!-- STATUS -->

            <div class="bank-form-group">

                <label>
                    Account Status
                </label>

                <input type="text"
                       class="form-control readonly-field"
                       value="Active"
                       readonly />

                <small class="form-help">
                    New accounts are created with Active status.
                </small>

            </div>


            <!-- ACCOUNT NUMBER -->

            <div class="bank-form-group">

                <label>
                    Account Number
                </label>

                <div class="auto-generated-field">

                    <span class="auto-generated-icon">
                        #
                    </span>

                    <input type="text"
                           class="form-control"
                           value="Automatically generated"
                           readonly />

                </div>

                <small class="form-help">
                    The system automatically generates the account number.
                </small>

            </div>


            <!-- SECURITY -->

            <div class="transaction-security-note">

                <span class="security-icon">
                    ✓
                </span>

                <div>

                    <strong>
                        Secure Account Creation
                    </strong>

                    <p>
                        Only registered customers can be assigned a new bank account.
                    </p>

                </div>

            </div>


            <!-- BUTTONS -->

            <div class="bank-form-actions">

                <button type="submit"
                        class="btn btn-primary transaction-submit-btn">

                    Create Account

                </button>

                @Html.ActionLink(
                    "Back to Accounts",
                    "Index",
                    "Account",
                    null,
                    new { @class = "btn btn-secondary" }
                )

            </div>

        }

    </div>


    <!-- =====================================================
         ACCOUNT INFORMATION
         ===================================================== -->

    <div class="transfer-info-card">

        <h4>
            Account Information
        </h4>

        <div class="transfer-info-divider"></div>


        <div class="transfer-info-item">

            <span>
                Account Number
            </span>

            <strong>
                Auto-generated
            </strong>

        </div>


        <div class="transfer-info-item">

            <span>
                Account Types
            </span>

            <strong>
                Savings / Current
            </strong>

        </div>


        <div class="transfer-info-item">

            <span>
                Initial Status
            </span>

            <strong class="processing-text">
                Active
            </strong>

        </div>


        <div class="transfer-info-item">

            <span>
                Balance
            </span>

            <strong>
                Administrator Defined
            </strong>

        </div>


        <div class="transfer-tip">

            <strong>
                💡 Important
            </strong>

            <p>
                Verify the selected customer and opening balance before creating the account.
            </p>

        </div>

    </div>

</div>


@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}