@model BankingManagement.DTOs.CreateAccountDTO

@{
    ViewBag.Title = "Create Account";
}

<h2>Create Account</h2>

@using (Html.BeginForm("Create", "Account", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(
                model => model.CustomerId,
                new { @class = "control-label" }
            )

            @Html.DropDownListFor(
                model => model.CustomerId,
                new SelectList(
                    ViewBag.Customers,
                    "CustomerId",
                    "FullName"
                ),
                "-- Select Customer --",
                new { @class = "form-control" }
            )

            @Html.ValidationMessageFor(
                model => model.CustomerId,
                "",
                new { @class = "text-danger" }
            )
        </div>

        <br />

        <div class="form-group">
            @Html.LabelFor(
                model => model.AccountType,
                new { @class = "control-label" }
            )

            @Html.DropDownListFor(
                model => model.AccountType,
                new SelectList(
                    new[]
                    {
                        "Savings",
                        "Current"
                    }
                ),
                "-- Select Account Type --",
                new { @class = "form-control" }
            )

            @Html.ValidationMessageFor(
                model => model.AccountType,
                "",
                new { @class = "text-danger" }
            )
        </div>

        <br />

        <div class="form-group">
            @Html.LabelFor(
                model => model.Balance,
                new { @class = "control-label" }
            )

            @Html.TextBoxFor(
                model => model.Balance,
                new
                {
                    @class = "form-control",
                    type = "number",
                    min = "0",
                    step = "0.01"
                }
            )

            @Html.ValidationMessageFor(
                model => model.Balance,
                "",
                new { @class = "text-danger" }
            )
        </div>

        <br />

        <div class="form-group">

            <label class="control-label">
                Status
            </label>

            <input type="text"
                   class="form-control"
                   value="Active"
                   readonly />

        </div>

        <br />

        <div class="form-group">

            <label class="control-label">
                Account Number
            </label>

            <input type="text"
                   class="form-control"
                   value="Automatically generated"
                   readonly />

        </div>

        <br />

        <button type="submit" class="btn btn-primary">
            Create Account
        </button>

        @Html.ActionLink(
            "Back to Accounts",
            "Index",
            "Account",
            null,
            new { @class = "btn btn-secondary" }
        )

    </div>
}

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}