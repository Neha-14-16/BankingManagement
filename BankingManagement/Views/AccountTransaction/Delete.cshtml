@model BankingManagement.DTOs.AccountTransactionDTO

@{
    ViewBag.Title = "Delete Transaction";
}

<h2>Delete Transaction</h2>

<hr />

<h4>
    Are you sure you want to delete this transaction?
</h4>

<br />

<table class="table table-bordered">

    <tr>
        <th>Account Number</th>
        <td>@Model.AccountNumber</td>
    </tr>

    <tr>
        <th>Transaction Type</th>
        <td>@Model.TransactionType</td>
    </tr>

    <tr>
        <th>Amount</th>
        <td>₹ @Model.Amount</td>
    </tr>

    <tr>
        <th>Transaction Date</th>
        <td>@Model.TransactionDate</td>
    </tr>

    <tr>
        <th>Status</th>
        <td>@Model.Status</td>
    </tr>

    <tr>
        <th>Reference Number</th>
        <td>@Model.ReferenceNumber</td>
    </tr>

</table>

<br />

@using (Html.BeginForm(
    "DeleteConfirmed",
    "AccountTransaction",
    FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(
        model => model.AccountTransactionId
    )

    <button type="submit"
            class="btn btn-danger">

        Delete Transaction

    </button>

    <span style="margin-left:10px;"></span>

    @Html.ActionLink(
        "Cancel",
        "Index",
        "AccountTransaction",
        null,
        new { @class = "btn btn-secondary" }
    )
}