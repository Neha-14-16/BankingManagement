@model BankingManagement.DTOs.CreateBankingTransactionDTO

@{
    ViewBag.Title = "Create Transfer";
}

<h2>Create Transfer</h2>

@using (Html.BeginForm("Create", "BankingTransaction", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">

        @Html.ValidationSummary(
            true,
            "",
            new { @class = "text-danger" }
        )

        <div class="form-group">

            @Html.LabelFor(
                model => model.FromAccountId,
                "From Account",
                new { @class = "control-label" }
            )

            @Html.DropDownListFor(
                model => model.FromAccountId,
                new SelectList(
                    ViewBag.Accounts,
                    "AccountId",
                    "AccountNumber"
                ),
                "-- Select Source Account --",
                new { @class = "form-control" }
            )

            @Html.ValidationMessageFor(
                model => model.FromAccountId,
                "",
                new { @class = "text-danger" }
            )

        </div>

        <br />

        <div class="form-group">

            @Html.LabelFor(
                model => model.ToAccountId,
                "To Account",
                new { @class = "control-label" }
            )

            @Html.DropDownListFor(
                model => model.ToAccountId,
                new SelectList(
                    ViewBag.Accounts,
                    "AccountId",
                    "AccountNumber"
                ),
                "-- Select Destination Account --",
                new { @class = "form-control" }
            )

            @Html.ValidationMessageFor(
                model => model.ToAccountId,
                "",
                new { @class = "text-danger" }
            )

        </div>

        <br />

        <div class="form-group">

            @Html.LabelFor(
                model => model.Amount,
                new { @class = "control-label" }
            )

            @Html.TextBoxFor(
                model => model.Amount,
                new
                {
                    @class = "form-control",
                    type = "number",
                    min = "0.01",
                    step = "0.01"
                }
            )

            @Html.ValidationMessageFor(
                model => model.Amount,
                "",
                new { @class = "text-danger" }
            )

        </div>

        <br />

        <button type="submit" class="btn btn-primary">
            Transfer Money
        </button>

        @Html.ActionLink(
            "Back to Transactions",
            "Index",
            "BankingTransaction",
            null,
            new { @class = "btn btn-secondary" }
        )

    </div>
}

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}