@model BankingManagement.DTOs.BeneficiaryDTO

@{
    ViewBag.Title = "Delete Beneficiary";
}

<h2>Delete Beneficiary</h2>

<h3>Are you sure you want to delete this beneficiary?</h3>

<div>
    <hr />

    <dl class="dl-horizontal">

        <dt>
            @Html.DisplayNameFor(
                model => model.BeneficiaryId
            )
        </dt>

        <dd>
            @Html.DisplayFor(
                model => model.BeneficiaryId
            )
        </dd>

        <dt>
            @Html.DisplayNameFor(
                model => model.CustomerId
            )
        </dt>

        <dd>
            @Html.DisplayFor(
                model => model.CustomerId
            )
        </dd>

        <dt>
            @Html.DisplayNameFor(
                model => model.BeneficiaryName
            )
        </dt>

        <dd>
            @Html.DisplayFor(
                model => model.BeneficiaryName
            )
        </dd>

        <dt>
            @Html.DisplayNameFor(
                model => model.AccountNumber
            )
        </dt>

        <dd>
            @Html.DisplayFor(
                model => model.AccountNumber
            )
        </dd>

        <dt>
            @Html.DisplayNameFor(
                model => model.IFSCCode
            )
        </dt>

        <dd>
            @Html.DisplayFor(
                model => model.IFSCCode
            )
        </dd>

        <dt>
            @Html.DisplayNameFor(
                model => model.BankName
            )
        </dt>

        <dd>
            @Html.DisplayFor(
                model => model.BankName
            )
        </dd>

    </dl>

    @using (Html.BeginForm(
        "DeleteConfirmed",
        "Beneficiary",
        new { id = Model.BeneficiaryId },
        FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(
            model => model.BeneficiaryId
        )

        <button type="submit" class="btn btn-danger">
            Delete Beneficiary
        </button>

        @Html.ActionLink(
            "Back to Beneficiaries",
            "Index",
            "Beneficiary",
            null,
            new { @class = "btn btn-secondary" }
        )
    }

</div>