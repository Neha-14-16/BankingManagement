@model BankingManagement.DTOs.CustomerDTO

@{
    ViewBag.Title = "Edit Customer";
}

<div class="bank-page-header">

    <div>

        <p class="section-label">
            CUSTOMER MANAGEMENT
        </p>

        <h2>
            Edit Customer
        </h2>

        <p class="bank-page-subtitle">
            Update the customer's registered information.
        </p>

    </div>

    <div class="secure-badge">
        🔒 Administrator
    </div>

</div>


<div class="transfer-layout">

    <!-- =====================================================
         EDIT FORM
         ===================================================== -->

    <div class="bank-form-card">

        <div class="bank-form-header">

            <div class="bank-form-icon">
                ✎
            </div>

            <div>

                <h3>
                    Customer Information
                </h3>

                <p>
                    Update the details that need to be changed.
                </p>

            </div>

        </div>

        <hr />

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(
                model => model.CustomerId
            )

            @Html.HiddenFor(
                model => model.UserId
            )

            @Html.ValidationSummary(
                true,
                "",
                new { @class = "text-danger" }
            )


            <!-- NAME -->

            <div class="bank-form-group">

                @Html.LabelFor(
                    model => model.FullName,
                    "Full Name"
                )

                @Html.TextBoxFor(
                    model => model.FullName,
                    new
                    {
                        @class = "form-control",
                        placeholder = "Enter full name"
                    }
                )

                @Html.ValidationMessageFor(
                    model => model.FullName,
                    "",
                    new { @class = "text-danger" }
                )

            </div>


            <!-- EMAIL + PHONE -->

            <div class="customer-form-row">

                <div class="bank-form-group">

                    @Html.LabelFor(
                        model => model.Email,
                        "Email Address"
                    )

                    @Html.TextBoxFor(
                        model => model.Email,
                        new
                        {
                            @class = "form-control",
                            type = "email",
                            placeholder = "example@email.com"
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.Email,
                        "",
                        new { @class = "text-danger" }
                    )

                </div>


                <div class="bank-form-group">

                    @Html.LabelFor(
                        model => model.PhoneNumber,
                        "Phone Number"
                    )

                    @Html.TextBoxFor(
                        model => model.PhoneNumber,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Enter phone number"
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.PhoneNumber,
                        "",
                        new { @class = "text-danger" }
                    )

                </div>

            </div>


            <!-- DATE OF BIRTH -->

            <div class="bank-form-group">

                @Html.LabelFor(
                    model => model.DateOfBirth,
                    "Date of Birth"
                )

                @Html.TextBoxFor(
                    model => model.DateOfBirth,
                    "{0:yyyy-MM-dd}",
                    new
                    {
                        @class = "form-control",
                        type = "date"
                    }
                )

                @Html.ValidationMessageFor(
                    model => model.DateOfBirth,
                    "",
                    new { @class = "text-danger" }
                )

            </div>


            <!-- ADDRESS -->

            <div class="bank-form-group">

                @Html.LabelFor(
                    model => model.Address,
                    "Address"
                )

                @Html.TextAreaFor(
                    model => model.Address,
                    new
                    {
                        @class = "form-control",
                        rows = 4,
                        placeholder = "Enter customer address"
                    }
                )

                @Html.ValidationMessageFor(
                    model => model.Address,
                    "",
                    new { @class = "text-danger" }
                )

            </div>


            <!-- SECURITY -->

            <div class="transaction-security-note">

                <span class="security-icon">
                    ✓
                </span>

                <div>

                    <strong>
                        Secure Profile Update
                    </strong>

                    <p>
                        Verify the updated customer information before saving changes.
                    </p>

                </div>

            </div>


            <!-- ACTIONS -->

            <div class="bank-form-actions">

                <button type="submit"
                        class="btn btn-primary transaction-submit-btn">

                    Save Changes

                </button>

                @Html.ActionLink(
                    "Back to Customers",
                    "Index",
                    "Customer",
                    null,
                    new { @class = "btn btn-secondary" }
                )

            </div>
        }

    </div>


    <!-- =====================================================
         INFORMATION CARD
         ===================================================== -->

    <div class="transfer-info-card">

        <h4>
            Customer Profile
        </h4>

        <div class="transfer-info-divider"></div>


        <div class="transfer-info-item">

            <span>
                Customer ID
            </span>

            <strong>
                @Model.CustomerId
            </strong>

        </div>


        <div class="transfer-info-item">

            <span>
                User ID
            </span>

            <strong>
                @Model.UserId
            </strong>

        </div>


        <div class="transfer-info-item">

            <span>
                Profile
            </span>

            <strong>
                Customer
            </strong>

        </div>


        <div class="transfer-info-item">

            <span>
                Access
            </span>

            <strong class="processing-text">
                Customer Login
            </strong>

        </div>


        <div class="transfer-tip">

            <strong>
                💡 Important
            </strong>

            <p>
                Customer ID and User ID are maintained by the system and are not editable from this screen.
            </p>

        </div>

    </div>

</div>


@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}