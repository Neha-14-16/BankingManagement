@model BankingManagement.DTOs.CustomerDashboardDTO

@{
    ViewBag.Title = "Customer Dashboard";

    decimal totalBalance = 0;

    foreach (var account in Model.Accounts)
    {
        totalBalance += account.Balance;
    }
}

<!-- =====================================================
     DASHBOARD HEADER
     ===================================================== -->

<div class="dashboard-header">

    <div>

        <p class="dashboard-welcome">
            Welcome back
        </p>

        <h2>
            @Model.FullName
        </h2>

        <p class="dashboard-subtitle">
            Here's an overview of your banking activity.
        </p>

    </div>

    <div class="dashboard-user-card">

        <div class="dashboard-user-icon">
            @Model.FullName.Substring(0, 1).ToUpper()
        </div>

        <div>

            <strong>
                @Model.FullName
            </strong>

            <span>
                Customer
            </span>

        </div>

    </div>

</div>

<!-- =====================================================
     SUMMARY CARDS
     ===================================================== -->

<div class="row dashboard-summary">

    <div class="col-md-4">

        <div class="bank-card summary-card">

            <div class="bank-card-title">
                TOTAL BALANCE
            </div>

            <div class="bank-card-value">
                ₹ @totalBalance.ToString("N2")
            </div>

            <div class="bank-card-subtitle">
                Across all active accounts
            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="bank-card summary-card">

            <div class="bank-card-title">
                ACTIVE ACCOUNTS
            </div>

            <div class="bank-card-value">
                @Model.Accounts.Count
            </div>

            <div class="bank-card-subtitle">
                Bank accounts available
            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="bank-card summary-card">

            <div class="bank-card-title">
                BENEFICIARIES
            </div>

            <div class="bank-card-value">
                @Model.Beneficiaries.Count
            </div>

            <div class="bank-card-subtitle">
                Saved beneficiaries
            </div>

        </div>

    </div>

</div>

<!-- =====================================================
     MY ACCOUNTS
     ===================================================== -->

<div class="section-header">

    <div>

        <p class="section-label">
            ACCOUNTS
        </p>

        <h3>
            My Accounts
        </h3>

    </div>

</div>

@if (Model.Accounts.Count == 0)
{
    <div class="bank-card">

        <p>
            No accounts found.
        </p>

    </div>
}
else
{
    <div class="row">

        @foreach (var account in Model.Accounts)
        {
            <div class="col-md-6 col-lg-4">

                <div class="account-card">

                    <div class="account-label">
                        @account.AccountType Account
                    </div>

                    <div class="account-number">
                        @account.AccountNumber
                    </div>

                    <div class="account-balance">
                        ₹ @account.Balance.ToString("N2")
                    </div>

                    <div class="account-footer">

                        <span>
                            Available Balance
                        </span>

                        @if (account.Status.ToLower() == "active")
                        {
                            <span class="status-active">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="status-inactive">
                                @account.Status
                            </span>
                        }

                    </div>

                </div>

            </div>
        }

    </div>
}

<!-- =====================================================
     QUICK ACTIONS
     ===================================================== -->

<div class="section-header">

    <div>

        <p class="section-label">
            SERVICES
        </p>

        <h3>
            Quick Actions
        </h3>

    </div>

</div>

<div class="actions-panel banking-actions">

    <a href="@Url.Action("Create", "CustomerTransfer")"
       class="bank-action">

        <span class="bank-action-icon">
            ↗
        </span>

        <span>
            <strong>Transfer Money</strong>
            <small>Send money to an account</small>
        </span>

    </a>

    <a href="@Url.Action(
        "Create",
        "CustomerAccountTransaction"
    )"
       class="bank-action">

        <span class="bank-action-icon">
            ₹
        </span>

        <span>
            <strong>Deposit / Withdraw</strong>
            <small>Manage your account balance</small>
        </span>

    </a>

    <a href="@Url.Action(
        "Index",
        "CustomerPayment"
    )"
       class="bank-action">

        <span class="bank-action-icon">
            $
        </span>

        <span>
            <strong>Make Payment</strong>
            <small>Pay using Razorpay</small>
        </span>

    </a>

    <a href="@Url.Action(
        "Index",
        "CustomerBeneficiary"
    )"
       class="bank-action">

        <span class="bank-action-icon">
            +
        </span>

        <span>
            <strong>Beneficiaries</strong>
            <small>Manage saved beneficiaries</small>
        </span>

    </a>

</div>

<!-- =====================================================
     BENEFICIARIES
     ===================================================== -->

<div class="section-header">

    <div>

        <p class="section-label">
            PAYMENTS
        </p>

        <h3>
            My Beneficiaries
        </h3>

    </div>

    <div>

        @Html.ActionLink(
            "Manage All",
            "Index",
            "CustomerBeneficiary",
            null,
            new { @class = "section-link" }
        )

    </div>

</div>

@if (Model.Beneficiaries.Count == 0)
{
    <div class="bank-card empty-state">

        <p>
            No beneficiaries added yet.
        </p>

        @Html.ActionLink(
            "Add Beneficiary",
            "Create",
            "CustomerBeneficiary",
            null,
            new { @class = "btn btn-primary" }
        )

    </div>
}
else
{
    <div class="bank-card">

        <div class="table-responsive">

            <table class="table banking-table">

                <thead>

                    <tr>

                        <th>
                            Beneficiary
                        </th>

                        <th>
                            Account Number
                        </th>

                        <th>
                            IFSC
                        </th>

                        <th>
                            Bank
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var beneficiary in Model.Beneficiaries)
                    {
                        <tr>

                            <td>

                                <strong>
                                    @beneficiary.BeneficiaryName
                                </strong>

                            </td>

                            <td>
                                @beneficiary.AccountNumber
                            </td>

                            <td>
                                @beneficiary.IFSCCode
                            </td>

                            <td>
                                @beneficiary.BankName
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
}

<!-- =====================================================
     TRANSACTIONS
     ===================================================== -->

<div class="section-header">

    <div>

        <p class="section-label">
            ACTIVITY
        </p>

        <h3>
            Recent Transactions
        </h3>

    </div>

</div>

@if (Model.Transactions.Count == 0)
{
    <div class="bank-card empty-state">

        <p>
            No transactions found.
        </p>

    </div>
}
else
{
    <div class="bank-card">

        <div class="table-responsive">

            <table class="table banking-table">

                <thead>

                    <tr>

                        <th>
                            From
                        </th>

                        <th>
                            To
                        </th>

                        <th>
                            Amount
                        </th>

                        <th>
                            Date
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Reference
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var transaction in Model.Transactions
                        .OrderByDescending(t => t.TransactionDate))
                    {
                        <tr>

                            <td>
                                @transaction.FromAccountNumber
                            </td>

                            <td>
                                @transaction.ToAccountNumber
                            </td>

                            <td>

                                <strong>
                                    ₹ @transaction.Amount.ToString("N2")
                                </strong>

                            </td>

                            <td>
                                @transaction.TransactionDate.ToString(
                                    "dd MMM yyyy, hh:mm tt"
                                )
                            </td>

                            <td>

                                @if (transaction.Status.ToLower() == "success")
                                {
                                    <span class="status-success">
                                        Success
                                    </span>
                                }
                                else
                                {
                                    <span class="status-failed">
                                        @transaction.Status
                                    </span>
                                }

                            </td>

                            <td>
                                @transaction.ReferenceNumber
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
}

<!-- =====================================================
     CUSTOMER INFORMATION
     ===================================================== -->

<div class="section-header">

    <div>

        <p class="section-label">
            PROFILE
        </p>

        <h3>
            Customer Details
        </h3>

    </div>

</div>

<div class="bank-card customer-profile-card">

    <div class="profile-item">

        <span>
            Full Name
        </span>

        <strong>
            @Model.FullName
        </strong>

    </div>

    <div class="profile-item">

        <span>
            Email
        </span>

        <strong>
            @Model.Email
        </strong>

    </div>

    <div class="profile-item">

        <span>
            Phone Number
        </span>

        <strong>
            @Model.PhoneNumber
        </strong>

    </div>

</div>

<!-- =====================================================
     LOGOUT
     ===================================================== -->

<div class="dashboard-logout">

    @Html.ActionLink(
        "Logout",
        "Logout",
        "Login",
        null,
        new { @class = "btn btn-danger" }
    )

</div>

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}