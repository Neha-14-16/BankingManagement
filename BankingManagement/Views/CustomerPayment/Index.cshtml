@model BankingManagement.DTOs.CreatePaymentTransactionDTO

@{
    ViewBag.Title = "Make Payment";
}


<div class="bank-page-header">

    <div>

        <p class="section-label">
            PAYMENTS
        </p>

        <h2>
            Make Payment
        </h2>

        <p class="bank-page-subtitle">
            Make a secure payment using Razorpay.
        </p>

    </div>

    <div class="secure-badge">
        🔒 Secure Payment
    </div>

</div>



<div class="transfer-layout">


    <!-- =====================================================
         PAYMENT FORM
         ===================================================== -->

    <div class="bank-form-card">

        <div class="bank-form-header">

            <div class="bank-form-icon">
                ₹
            </div>

            <div>

                <h3>
                    Payment Details
                </h3>

                <p>
                    Select your account and enter the payment amount.
                </p>

            </div>

        </div>


        <hr />


        @using (Html.BeginForm(
            "CreateOrder",
            "CustomerPayment",
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(
                true,
                "",
                new { @class = "text-danger" }
            )


            <!-- =================================================
                 ACCOUNT
                 ================================================= -->

            <div class="bank-form-group">

                @Html.LabelFor(
                    model => model.AccountId,
                    "Account Number"
                )


                <select name="AccountId"
                        class="form-control"
                        required>

                    <option value="">
                        -- Select Your Account --
                    </option>


                    @if (ViewBag.Accounts != null)
                    {
                        foreach (var account in ViewBag.Accounts)
                        {
                            <option value="@account.AccountId">

                                @account.AccountNumber -
                                @account.AccountType

                            </option>
                        }
                    }

                </select>


                <small class="form-help">
                    Select the account from which the payment will be made.
                </small>


                @Html.ValidationMessageFor(
                    model => model.AccountId,
                    "",
                    new { @class = "text-danger" }
                )

            </div>



            <!-- =================================================
                 AMOUNT
                 ================================================= -->

            <div class="bank-form-group">

                @Html.LabelFor(
                    model => model.Amount,
                    "Payment Amount"
                )


                <div class="amount-input-wrapper">

                    <span class="currency-symbol">
                        ₹
                    </span>


                    @Html.TextBoxFor(
                        model => model.Amount,
                        new
                        {
                            @class = "form-control amount-input",
                            type = "number",
                            step = "0.01",
                            min = "0.01",
                            placeholder = "0.00"
                        }
                    )

                </div>


                <small class="form-help">
                    Enter the amount you want to pay.
                </small>


                @Html.ValidationMessageFor(
                    model => model.Amount,
                    "",
                    new { @class = "text-danger" }
                )

            </div>



            <!-- =================================================
                 PAYMENT TYPE
                 ================================================= -->

            <div class="bank-form-group">

                @Html.LabelFor(
                    model => model.PaymentType,
                    "Payment Method"
                )


                <select name="PaymentType"
                        class="form-control"
                        required>

                    <option value="">
                        -- Select Payment Method --
                    </option>

                    <option value="Razorpay">
                        Razorpay
                    </option>

                </select>


                <small class="form-help">
                    Payments are currently processed through Razorpay Test Mode.
                </small>


                @Html.ValidationMessageFor(
                    model => model.PaymentType,
                    "",
                    new { @class = "text-danger" }
                )

            </div>



            <!-- =================================================
                 SECURITY
                 ================================================= -->

            <div class="transaction-security-note">

                <span class="security-icon">
                    ✓
                </span>

                <div>

                    <strong>
                        Secure Payment Processing
                    </strong>

                    <p>
                        Your payment is processed through the Razorpay payment gateway.
                    </p>

                </div>

            </div>



            <!-- =================================================
                 BUTTONS
                 ================================================= -->

            <div class="bank-form-actions">

                <button type="submit"
                        class="btn btn-primary transaction-submit-btn">

                    Create Razorpay Order

                </button>


                @Html.ActionLink(
                    "Back to Dashboard",
                    "Index",
                    "CustomerDashboard",
                    null,
                    new { @class = "btn btn-secondary" }
                )

            </div>

        }

    </div>



    <!-- =====================================================
         PAYMENT INFORMATION
         ===================================================== -->

    <div class="transfer-info-card">

        <h4>
            Payment Information
        </h4>


        <div class="transfer-info-divider"></div>


        <div class="transfer-info-item">

            <span>
                Payment Method
            </span>

            <strong>
                Razorpay
            </strong>

        </div>


        <div class="transfer-info-item">

            <span>
                Payment Mode
            </span>

            <strong>
                Test Mode
            </strong>

        </div>


        <div class="transfer-info-item">

            <span>
                Processing
            </span>

            <strong class="processing-text">
                Secure
            </strong>

        </div>


        <div class="transfer-info-item">

            <span>
                Account Update
            </span>

            <strong>
                On Successful Payment
            </strong>

        </div>


        <div class="transfer-tip">

            <strong>
                💡 Payment Info
            </strong>

            <p>
                A Razorpay test order is created before the payment process.
                No real money is charged.
            </p>

        </div>

    </div>

</div>



<!-- =====================================================
     RAZORPAY TEST ORDER
     ===================================================== -->

@if (ViewBag.OrderId != null)
{
    <div class="bank-card payment-order-card">


        <!-- ORDER HEADER -->

        <div class="payment-order-header">

            <div>

                <p class="section-label">
                    RAZORPAY
                </p>

                <h3>
                    Test Order Created
                </h3>

            </div>


            <span class="status-success">
                Ready
            </span>

        </div>



        <!-- ORDER DETAILS -->

        <div class="payment-order-details">

            <div>

                <span>
                    Order ID
                </span>

                <strong>
                    @ViewBag.OrderId
                </strong>

            </div>


            <div>

                <span>
                    Amount
                </span>

                <strong>
                    ₹ @Model.Amount.ToString("N2")
                </strong>

            </div>


            <div>

                <span>
                    Payment Type
                </span>

                <strong>
                    @Model.PaymentType
                </strong>

            </div>

        </div>



        <!-- =================================================
             RAZORPAY CHECKOUT
             ================================================= -->

        <div class="payment-checkout-area">

            <h4>
                Razorpay Checkout
            </h4>

            <p>
                Open the Razorpay Test Checkout to continue.
            </p>


            <button type="button"
                    id="openRazorpayButton"
                    class="btn btn-primary"
                    data-key="@BankingManagement.Services.RazorpayConfig.KeyId"
                    data-order-id="@ViewBag.OrderId"
                    data-amount="@((Model.Amount * 100).ToString("0"))">

                Open Razorpay Checkout

            </button>

        </div>



        <hr />



        <!-- =================================================
             PROJECT TEST FLOW
             ================================================= -->

        <div class="test-payment-area">

            <p class="section-label">
                PROJECT TEST FLOW
            </p>

            <h4>
                Payment Result
            </h4>

            <p>
                Your project uses a payment flag for testing.
                No actual payment is required.
            </p>


            <div class="test-payment-buttons">


                <!-- =================================================
                     SUCCESS PAYMENT
                     ================================================= -->

                @using (Html.BeginForm(
                    "ProcessPaymentFlag",
                    "CustomerPayment",
                    FormMethod.Post))
                {
                    @Html.AntiForgeryToken()


                    @Html.Hidden(
                        "AccountId",
                        Model.AccountId
                    )


                    @Html.Hidden(
                        "Amount",
                        Model.Amount
                    )


                    @Html.Hidden(
                        "PaymentType",
                        Model.PaymentType
                    )


                    @Html.Hidden(
                        "PaymentFlag",
                        "Success"
                    )


                    @Html.Hidden(
                        "RazorpayOrderId",
                        ViewBag.OrderId as string
                    )


                    <button type="submit"
                            class="btn btn-success">

                        Test Successful Payment

                    </button>
                }



                <!-- =================================================
                     FAILED PAYMENT
                     ================================================= -->

                @using (Html.BeginForm(
                    "ProcessPaymentFlag",
                    "CustomerPayment",
                    FormMethod.Post))
                {
                    @Html.AntiForgeryToken()


                    @Html.Hidden(
                        "AccountId",
                        Model.AccountId
                    )


                    @Html.Hidden(
                        "Amount",
                        Model.Amount
                    )


                    @Html.Hidden(
                        "PaymentType",
                        Model.PaymentType
                    )


                    @Html.Hidden(
                        "PaymentFlag",
                        "Failed"
                    )


                    @Html.Hidden(
                        "RazorpayOrderId",
                        ViewBag.OrderId as string
                    )


                    <button type="submit"
                            class="btn btn-danger">

                        Test Failed Payment

                    </button>
                }

            </div>

        </div>

    </div>
}



<!-- =====================================================
     SCRIPTS
     ===================================================== -->

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")

    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

    <script src="@Url.Content("~/Scripts/razorpay-payment.js")"></script>
}