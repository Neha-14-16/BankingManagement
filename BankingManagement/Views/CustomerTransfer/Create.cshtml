@model BankingManagement.DTOs.CustomerTransferDTO

@{
    ViewBag.Title = "Transfer Money";
}

<h2>Transfer Money</h2>

<hr />

@using (Html.BeginForm(
    "Create",
    "CustomerTransfer",
    FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">

        @Html.ValidationSummary(
            true,
            "",
            new { @class = "text-danger" }
        )

        <div class="form-group">

            @Html.LabelFor(
                model => model.FromAccountId,
                "From Account",
                new { @class = "control-label" }
            )

            @Html.DropDownListFor(
                model => model.FromAccountId,
                new SelectList(
                    ViewBag.Accounts,
                    "AccountId",
                    "AccountNumber"
                ),
                "-- Select Your Account --",
                new { @class = "form-control" }
            )

            @Html.ValidationMessageFor(
                model => model.FromAccountId,
                "",
                new { @class = "text-danger" }
            )

        </div>

        <br />

        <div class="form-group">

            @Html.LabelFor(
                model => model.BeneficiaryId,
                "Beneficiary",
                new { @class = "control-label" }
            )

            @Html.DropDownListFor(
                model => model.BeneficiaryId,
                new SelectList(
                    ViewBag.Beneficiaries,
                    "BeneficiaryId",
                    "BeneficiaryName"
                ),
                "-- Select Beneficiary --",
                new { @class = "form-control" }
            )

            @Html.ValidationMessageFor(
                model => model.BeneficiaryId,
                "",
                new { @class = "text-danger" }
            )

        </div>

        <br />

        <div class="form-group">

            @Html.LabelFor(
                model => model.Amount,
                new { @class = "control-label" }
            )

            @Html.TextBoxFor(
                model => model.Amount,
                new
                {
                    @class = "form-control",
                    type = "number",
                    min = "0.01",
                    step = "0.01",
                    placeholder = "Enter amount"
                }
            )

            @Html.ValidationMessageFor(
                model => model.Amount,
                "",
                new { @class = "text-danger" }
            )

        </div>

        <br />

        <button type="submit"
                class="btn btn-primary">

            Transfer Money

        </button>

        <span style="margin-left: 10px;"></span>

        @Html.ActionLink(
            "Back to Dashboard",
            "Index",
            "CustomerDashboard",
            null,
            new { @class = "btn btn-secondary" }
        )

    </div>
}

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}