@model BankingManagement.DTOs.CustomerTransferDTO

@{
    ViewBag.Title = "Transfer Money";
}

<div class="bank-page-header">

    <div>
        <p class="section-label">MONEY TRANSFER</p>

        <h2>Transfer Money</h2>

        <p class="bank-page-subtitle">
            Send money securely to one of your saved beneficiaries.
        </p>
    </div>

    <div class="secure-badge">
        🔒 Secure Transfer
    </div>

</div>

<div class="transfer-layout">

    <div class="bank-form-card">

        <div class="bank-form-header">

            <div class="bank-form-icon">
                ↗
            </div>

            <div>
                <h3>Make a Transfer</h3>

                <p>
                    Select your account, beneficiary and transfer amount.
                </p>
            </div>

        </div>

        <hr />

        @using (Html.BeginForm(
            "Create",
            "CustomerTransfer",
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(
                true,
                "",
                new { @class = "text-danger" }
            )

            <div class="bank-form-group">

                @Html.LabelFor(
                    model => model.FromAccountId,
                    "From Account"
                )

                @Html.DropDownListFor(
                    model => model.FromAccountId,
                    new SelectList(
                        ViewBag.Accounts,
                        "AccountId",
                        "AccountNumber"
                    ),
                    "-- Select Your Account --",
                    new
                    {
                        @class = "form-control"
                    }
                )

                <small class="form-help">
                    Select the account from which you want to send money.
                </small>

                @Html.ValidationMessageFor(
                    model => model.FromAccountId,
                    "",
                    new { @class = "text-danger" }
                )

            </div>

            <div class="bank-form-group">

                @Html.LabelFor(
                    model => model.BeneficiaryId,
                    "Beneficiary"
                )

                @Html.DropDownListFor(
                    model => model.BeneficiaryId,
                    new SelectList(
                        ViewBag.Beneficiaries,
                        "BeneficiaryId",
                        "BeneficiaryName"
                    ),
                    "-- Select Beneficiary --",
                    new
                    {
                        @class = "form-control"
                    }
                )

                <small class="form-help">
                    Choose one of your saved beneficiaries.
                </small>

                @Html.ValidationMessageFor(
                    model => model.BeneficiaryId,
                    "",
                    new { @class = "text-danger" }
                )

            </div>

            <div class="bank-form-group">

                @Html.LabelFor(
                    model => model.Amount,
                    "Transfer Amount"
                )

                <div class="amount-input-wrapper">

                    <span class="currency-symbol">
                        ₹
                    </span>

                    @Html.TextBoxFor(
                        model => model.Amount,
                        new
                        {
                            @class = "form-control amount-input",
                            type = "number",
                            min = "0.01",
                            step = "0.01",
                            placeholder = "0.00"
                        }
                    )

                </div>

                <small class="form-help">
                    Enter the amount you want to transfer.
                </small>

                @Html.ValidationMessageFor(
                    model => model.Amount,
                    "",
                    new { @class = "text-danger" }
                )

            </div>

            <div class="transfer-security-note">

                <span class="security-icon">
                    ✓
                </span>

                <div>
                    <strong>Secure Banking Transfer</strong>

                    <p>
                        Your transfer will be processed securely through the banking system.
                    </p>
                </div>

            </div>

            <div class="bank-form-actions">

                <button type="submit"
                        class="btn btn-primary transfer-submit-btn">

                    Transfer Money

                </button>

                @Html.ActionLink(
                    "Back to Dashboard",
                    "Index",
                    "CustomerDashboard",
                    null,
                    new { @class = "btn btn-secondary" }
                )

            </div>
        }

    </div>


    <div class="transfer-info-card">

        <h4>Transfer Summary</h4>

        <div class="transfer-info-divider"></div>

        <div class="transfer-info-item">

            <span>
                Transfer Type
            </span>

            <strong>
                Account Transfer
            </strong>

        </div>

        <div class="transfer-info-item">

            <span>
                Source
            </span>

            <strong>
                Your Bank Account
            </strong>

        </div>

        <div class="transfer-info-item">

            <span>
                Destination
            </span>

            <strong>
                Saved Beneficiary
            </strong>

        </div>

        <div class="transfer-info-item">

            <span>
                Processing
            </span>

            <strong class="processing-text">
                Instant
            </strong>

        </div>

        <div class="transfer-tip">

            <strong>
                💡 Transfer Tip
            </strong>

            <p>
                Make sure you have sufficient balance in your selected account before transferring money.
            </p>

        </div>

    </div>

</div>

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}