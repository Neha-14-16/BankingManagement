@{
    ViewBag.Title = "Contact";
}

<main class="contact-page">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <section class="contact-hero">

        <div class="contact-hero-icon">
            ✉
        </div>

        <div>

            <span class="home-badge">
                GET IN TOUCH
            </span>

            <h1>
                Contact Banking Management
            </h1>

            <p>
                Have a question about the banking application?
                Use the information below for support and
                application-related queries.
            </p>

        </div>

    </section>


    <!-- =====================================================
         CONTACT CONTENT
         ===================================================== -->

    <section class="contact-content">

        <!-- Main Contact Card -->

        <div class="contact-main-card">

            <span class="section-label">
                SUPPORT
            </span>

            <h2>
                How Can We Help?
            </h2>

            <p>
                For questions related to customers, accounts,
                transactions, beneficiaries or payments,
                refer to the relevant section of the application
                or contact the project support team.
            </p>


            <div class="contact-info-grid">

                <div class="contact-info-item">

                    <div class="contact-info-icon">
                        🏦
                    </div>

                    <div>

                        <span>
                            Application
                        </span>

                        <strong>
                            Banking Management
                        </strong>

                    </div>

                </div>


                <div class="contact-info-item">

                    <div class="contact-info-icon">
                        🔐
                    </div>

                    <div>

                        <span>
                            Support Area
                        </span>

                        <strong>
                            Banking & Account Services
                        </strong>

                    </div>

                </div>


                <div class="contact-info-item">

                    <div class="contact-info-icon">
                        💬
                    </div>

                    <div>

                        <span>
                            Assistance
                        </span>

                        <strong>
                            Application Support
                        </strong>

                    </div>

                </div>


                <div class="contact-info-item">

                    <div class="contact-info-icon">
                        ⏱
                    </div>

                    <div>

                        <span>
                            Service
                        </span>

                        <strong>
                            Banking Operations
                        </strong>

                    </div>

                </div>

            </div>

        </div>


        <!-- Quick Help Card -->

        <div class="contact-side-card">

            <span class="section-label">
                QUICK HELP
            </span>

            <h3>
                Common Areas
            </h3>


            <div class="contact-help-item">

                <span class="contact-help-icon">
                    👤
                </span>

                <div>

                    <strong>
                        Customer Management
                    </strong>

                    <p>
                        Customer profile and registration support.
                    </p>

                </div>

            </div>


            <div class="contact-help-item">

                <span class="contact-help-icon">
                    💳
                </span>

                <div>

                    <strong>
                        Account Services
                    </strong>

                    <p>
                        Account, balance and status-related queries.
                    </p>

                </div>

            </div>


            <div class="contact-help-item">

                <span class="contact-help-icon">
                    ⇄
                </span>

                <div>

                    <strong>
                        Transactions
                    </strong>

                    <p>
                        Transfers, deposits and withdrawals.
                    </p>

                </div>

            </div>


            <div class="contact-help-item">

                <span class="contact-help-icon">
                    🔑
                </span>

                <div>

                    <strong>
                        Password Recovery
                    </strong>

                    <p>
                        Use Forgot Password to recover account access.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         MESSAGE / APPLICATION NOTE
         ===================================================== -->

    <section class="contact-note">

        <div class="contact-note-icon">
            🛡️
        </div>

        <div>

            <span class="section-label">
                SECURITY NOTE
            </span>

            <h2>
                Keep Your Banking Information Secure
            </h2>

            <p>
                Never share your password, reset token or other
                confidential banking information with another person.
            </p>

        </div>

    </section>

</main>