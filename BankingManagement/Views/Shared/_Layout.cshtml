@{
    string currentRole = Session["Role"] as string;

    bool isLoggedIn = Session["UserId"] != null;

    bool isAdmin = false;
    bool isCustomer = false;

    if (!string.IsNullOrEmpty(currentRole))
    {
        isAdmin = currentRole.ToLower() == "admin";
        isCustomer = currentRole.ToLower() == "customer";
    }
}

<!DOCTYPE html>
<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewBag.Title - Banking Management
    </title>

    @Styles.Render("~/Content/css")

    <link rel="stylesheet"
          href="@Url.Content("~/Content/Banking.css")" />

    @Scripts.Render("~/bundles/modernizr")

</head>

<body>

    <!-- =====================================================
         BANKING NAVBAR
         ===================================================== -->

    <nav class="navbar navbar-expand-lg banking-navbar">

        <div class="container banking-navbar-container">

            <!-- BRAND -->

            @Html.ActionLink(
                "Banking Management",
                "Index",
                "Home",
                new { area = "" },
                new { @class = "navbar-brand banking-brand" }
            )


            <!-- MOBILE MENU -->

            <button type="button"
                    class="navbar-toggler banking-navbar-toggler"
                    data-bs-toggle="collapse"
                    data-bs-target="#bankingNavbar"
                    aria-controls="bankingNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>


            <!-- =================================================
                 NAVIGATION
                 ================================================= -->

            <div class="collapse navbar-collapse"
                 id="bankingNavbar">


                <!-- =================================================
                     LEFT SIDE NAVIGATION
                     ================================================= -->

                <ul class="navbar-nav me-auto banking-nav">

                    <!-- HOME -->

                    <li class="nav-item">

                        @Html.ActionLink(
                            "Home",
                            "Index",
                            "Home",
                            new { area = "" },
                            new { @class = "nav-link banking-nav-link" }
                        )

                    </li>


                    <!-- =================================================
                         ADMIN MENU
                         ================================================= -->

                    @if (isLoggedIn && isAdmin)
                    {
                        <li class="nav-item">

                            @Html.ActionLink(
                                "Dashboard",
                                "Index",
                                "AdminDashboard",
                                null,
                                new { @class = "nav-link banking-nav-link" }
                            )

                        </li>

                        <li class="nav-item">

                            @Html.ActionLink(
                                "Users",
                                "Index",
                                "User",
                                null,
                                new { @class = "nav-link banking-nav-link" }
                            )

                        </li>

                        <li class="nav-item">

                            @Html.ActionLink(
                                "Customers",
                                "Index",
                                "Customer",
                                null,
                                new { @class = "nav-link banking-nav-link" }
                            )

                        </li>

                        <li class="nav-item">

                            @Html.ActionLink(
                                "Accounts",
                                "Index",
                                "Account",
                                null,
                                new { @class = "nav-link banking-nav-link" }
                            )

                        </li>
                    }


                    <!-- =================================================
                         CUSTOMER MENU
                         ================================================= -->

                    @if (isLoggedIn && isCustomer)
                    {
                        <li class="nav-item">

                            @Html.ActionLink(
                                "Dashboard",
                                "Index",
                                "CustomerDashboard",
                                null,
                                new { @class = "nav-link banking-nav-link" }
                            )

                        </li>

                        <li class="nav-item">

                            @Html.ActionLink(
                                "Transfer",
                                "Create",
                                "CustomerTransfer",
                                null,
                                new { @class = "nav-link banking-nav-link" }
                            )

                        </li>

                        <li class="nav-item">

                            @Html.ActionLink(
                                "Beneficiaries",
                                "Index",
                                "CustomerBeneficiary",
                                null,
                                new { @class = "nav-link banking-nav-link" }
                            )

                        </li>

                        <li class="nav-item">

                            @Html.ActionLink(
                                "Payments",
                                "Index",
                                "CustomerPayment",
                                null,
                                new { @class = "nav-link banking-nav-link" }
                            )

                        </li>
                    }


                    <!-- =================================================
                         LOGGED OUT MENU
                         ================================================= -->

                    @if (!isLoggedIn)
                    {
                        <li class="nav-item">

                            @Html.ActionLink(
                                "About",
                                "About",
                                "Home",
                                new { area = "" },
                                new { @class = "nav-link banking-nav-link" }
                            )

                        </li>

                        <li class="nav-item">

                            @Html.ActionLink(
                                "Contact",
                                "Contact",
                                "Home",
                                new { area = "" },
                                new { @class = "nav-link banking-nav-link" }
                            )

                        </li>
                    }

                </ul>


                <!-- =================================================
                     RIGHT SIDE
                     ONLY LOGIN WHEN LOGGED OUT
                     ================================================= -->

                @if (!isLoggedIn)
                {
                    <ul class="navbar-nav banking-nav-right">

                        <li class="nav-item">

                            @Html.ActionLink(
                                "Login",
                                "Index",
                                "Login",
                                null,
                                new { @class = "banking-login-btn" }
                            )

                        </li>

                    </ul>
                }

            </div>

        </div>

    </nav>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <main class="container body-content">

        @RenderBody()

        <hr />


        <!-- =================================================
             FOOTER
             ================================================= -->

        <footer>

            <p>
                &copy; @DateTime.Now.Year
                Banking Management
            </p>

        </footer>

    </main>


    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->

    @Scripts.Render("~/bundles/jquery")

    @Scripts.Render("~/bundles/bootstrap")

    @RenderSection(
        "scripts",
        required: false
    )

</body>

</html>