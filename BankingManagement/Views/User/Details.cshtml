@model BankingManagement.DTOs.UserDTO

@{
    ViewBag.Title = "User Details";
}

<h2>User Details</h2>

<div>
    <dl class="dl-horizontal">

        <dt>User ID</dt>
        <dd>@Model.UserId</dd>

        <dt>Username</dt>
        <dd>@Model.Username</dd>

        <dt>Role</dt>
        <dd>@Model.Role</dd>

        <dt>Active</dt>
        <dd>@Model.IsActive</dd>

        <dt>Created Date</dt>
        <dd>@Model.CreatedDate</dd>

    </dl>
</div>

<p>
    @Html.ActionLink(
        "Edit",
        "Edit",
        new { id = Model.UserId },
        new { @class = "btn btn-primary" }
    )

    @Html.ActionLink(
        "Back to List",
        "Index",
        null,
        new { @class = "btn btn-secondary" }
    )
</p>