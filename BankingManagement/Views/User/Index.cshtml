@model IEnumerable<BankingManagement.DTOs.UserDTO>

@{
    ViewBag.Title = "Users";
}

<h2>Users</h2>

<p>
    @Html.ActionLink("Create New User", "Create")
</p>

<table class="table table-bordered">
    <tr>
        <th>User ID</th>
        <th>Username</th>
        <th>Email</th>
        <th>Role</th>
        <th>Active</th>
        <th>Created Date</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.UserId</td>
            <td>@item.Username</td>
            <td>@item.Email</td>
            <td>@item.Role</td>
            <td>@item.IsActive</td>
            <td>@item.CreatedDate</td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.UserId }) |
                @Html.ActionLink("Details", "Details", new { id = item.UserId }) |
                @Html.ActionLink("Delete", "DeleteUser", new { id = item.UserId })
            </td>
        </tr>
    }
</table>